# School demo: Nodemailer captures the message and provides a preview URL (no real delivery).
EMAIL_MODE=ethereal

# For real delivery, set EMAIL_MODE=smtp and configure a verified SMTP sender:
# EMAIL_MODE=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM=CondeShop <your-verified-sender@example.com>